# OS/editor noise
__MACOSX/
.DS_Store
._*
*.swp
*.swo

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Python / backend build artifacts
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
backend/.pytest_cache/
backend/.tmp_data/
backend/*.egg-info/

# Frontend artifacts
node_modules/
package-lock.json
!frontend/package-lock.json
tsconfig.tsbuildinfo
frontend/tsconfig.tsbuildinfo
frontend/tsconfig.app.tsbuildinfo
frontend/tsconfig.node.tsbuildinfo
frontend/node_modules/
dist/
frontend/dist/
build/
coverage/

# Evidence, uploads, generated data and local volumes
data/*
!data/.gitkeep
!data/evidence/
data/evidence/*
!data/evidence/.gitkeep
!data/tmp/
data/tmp/*
!data/tmp/.gitkeep
# Anchored to the repo root -- unanchored versions of these patterns also
# matched nested directories with the same name inside committed test
# fixtures (e.g. backend/tests/fixtures/velociraptor_collection_*/uploads/,
# which mirrors real Velociraptor collection layout), silently excluding
# small, legitimate fixture content from every `git add`.
/uploads/
/evidence/
/evidences/
/cases/
backups/
logs/
reports/generated/
opensearch_data/
postgres_data/
.tmp-backend-data/

# Parser/debug/generated outputs
parser-output/
parser_outputs/
parsed-output/
parsed_outputs/
exports/
graphify-out/
*.log

# Forensic evidence and case archives should never be added accidentally.
*.7z
*.zip
*.E01
*.e01
*.Ex01
*.raw
*.dd
*.aff4
*.ad1
*.vhd
*.vhdx
*.ost
*.pst
*.evtx
*.eml
*.msg
!backend/tests/fixtures/**/*.evtx
!backend/tests/fixtures/**/*.log

# Local synthetic/temp packs
/tmp_*/
/tmp_*.sh
demo/evidence/

# Local-only AI agent instructions (contains maintainer-specific deploy authority)
CLAUDE.md
