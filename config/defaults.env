# Kairon DFIR internal defaults. Do not store secrets here.
# Documentation status: technical draft pending maintainer review.

# ---- Postgres ----
POSTGRES_DB=dfir
POSTGRES_USER=dfir
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- OpenSearch ----
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_PREFIX=dfir-events
OPENSEARCH_JAVA_HEAP=2g


# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173
BACKEND_MAX_UPLOAD_SIZE=274877906944
BACKEND_UPLOAD_IDLE_TIMEOUT_SECONDS=60
BACKEND_DATA_DIR=/app/data
BACKEND_TEMP_DIR=/app/data/tmp
EVIDENCE_UPLOAD_SESSION_TTL_SECONDS=7200
BACKEND_LOG_LEVEL=INFO
BACKEND_UVICORN_WORKERS=1

# ---- Evidence paths ----
DFIR_ALLOW_HOST_PATH_IMPORT=false
DFIR_ALLOWED_EVIDENCE_ROOTS=/mnt/evidence,/data/evidence,/cases

# ---- Defaults: investigation mode ----
DFIR_ENABLE_DEMO_CASES=false
DFIR_DEFAULT_CASE_MODE=investigation

# ---- Extraction and ingest guards ----
# Zip-bomb guards. These were set well below the code defaults (10 GiB), which
# blocked ordinary DFIR work: a 1.2 GB Velociraptor collection expands past
# 2 GiB and a full triage collection holds far more than 20000 files, so a
# fresh install refused evidence it exists to analyse. Raised to the code
# default for bytes, and to a file count a real collection does not exceed.
BACKEND_MAX_EXTRACTED_FILES=200000
BACKEND_MAX_EXTRACTED_BYTES=10737418240
DISK_IMAGE_INGEST_ENABLED=true
DISK_IMAGE_MAX_BYTES=1099511627776
DISK_IMAGE_MAX_SEGMENTS=64
DISK_IMAGE_MAX_PARTITIONS=64
DISK_IMAGE_MAX_FILES_PER_VOLUME=50000
DISK_IMAGE_MAX_BYTES_PER_VOLUME=10737418240
DISK_IMAGE_MAX_DIRECTORY_DEPTH=16
DISK_IMAGE_MAX_PATH_LENGTH=4096
DISK_IMAGE_JOB_TIMEOUT_SECONDS=14400
DISK_IMAGE_INSPECTION_TIMEOUT_SECONDS=900
DISK_IMAGE_EXPORT_TIMEOUT_SECONDS=7200
DISK_IMAGE_ALLOWED_EXTENSIONS=.dd,.img,.raw,.e01,.ex01,.e02,.e03,.e04,.e05,.vmdk,.vhd,.vhdx,.qcow,.qcow2,.vdi
DISK_IMAGE_VIRTUAL_SIZE_MAX_BYTES=1099511627776
DISK_IMAGE_VIRTUAL_PHYSICAL_RATIO_MAX=100
DISK_IMAGE_MIN_FREE_SPACE_RESERVE=268435456
DISK_IMAGE_CONVERT_TIMEOUT=3600
DISK_IMAGE_CHECK_TIMEOUT=600
DISK_IMAGE_MAX_CHAIN_DEPTH=3
DISK_IMAGE_MAX_EXTENTS=64
INGEST_BATCH_SIZE=1000
OPENSEARCH_BULK_DOCS=1000
OPENSEARCH_BULK_BYTES=10485760
MAX_PARALLEL_ARTIFACTS=1
MAX_PARALLEL_RULE_RUNS=1
SEARCH_DEFAULT_PAGE_SIZE=50
SEARCH_MAX_PAGE_SIZE=1000

# ---- Rules ----
AUTO_CREATE_HEURISTIC_DETECTIONS=true
YARA_SCAN_RAW_EVIDENCE=true
YARA_SCAN_PARSED_OUTPUTS=false
YARA_SCAN_ARCHIVES=false
YARA_SCAN_TEXT_OUTPUTS=false
YARA_MAX_FILE_SIZE_MB=100

# ---- Memory Analysis ----
MEMORY_ANALYSIS_ENABLED=false
MEMORY_ALLOW_EXTERNAL_TOOL_EXECUTION=false
VOLATILITY3_COMMAND=vol
MEMPROCFS_COMMAND=memprocfs
# Opt-in: enables MemProcFS's built-in YARA rules (Elastic Security content) in FindEvil by
# accepting the Elastic License 2.0 on the operator's behalf. Off by default: this is a separate,
# non-OSI license from Kairon's and MemProcFS's own AGPL-3.0, and acceptance must be a deliberate
# operator choice, never silent. See docs/memory/memory_analysis.md ("YARA in Find Evil").
MEMPROCFS_YARA_ACCEPT_ELASTIC_LICENSE=false
MEMORY_BACKEND_CHECK_TIMEOUT_SECONDS=10
MEMORY_BACKEND_STATUS_CACHE_SECONDS=60
MEMORY_PREFERRED_BACKEND=volatility3
MEMORY_UPLOAD_ENABLED=false
MEMORY_UPLOAD_MAX_BYTES=274877906944
MEMORY_UPLOAD_DIRECT_THRESHOLD_BYTES=1073741824
MEMORY_UPLOAD_CHUNK_SIZE_BYTES=67108864
MEMORY_UPLOAD_DEFAULT_CONCURRENCY=2
MEMORY_UPLOAD_MAX_CONCURRENCY=4
MEMORY_UPLOAD_SESSION_TTL_HOURS=24
MEMORY_UPLOAD_STAGING_ROOT=
MEMORY_UPLOAD_CLEANUP_AGE_SECONDS=86400
MEMORY_UPLOAD_REQUEST_TIMEOUT_SECONDS=300
MEMORY_UPLOAD_VERIFICATION_TIMEOUT_SECONDS=300
MEMORY_UPLOAD_FINALIZATION_TIMEOUT_SECONDS=120
MEMORY_UPLOAD_STALE_TIMEOUT_SECONDS=900
MEMORY_UPLOAD_ALLOWED_EXTENSIONS=.raw,.mem,.vmem,.dmp,.lime
MEMORY_JOB_TIMEOUT_SECONDS=900
MEMORY_PLUGIN_TIMEOUT_SECONDS=600
MEMORY_PLUGIN_OUTPUT_MAX_BYTES=10485760
MEMORY_OUTPUT_DIR=
MEMORY_WORKER_MODE=external_command
MEMORY_TASK_QUEUE=memory
MEMORY_REQUIRE_DEDICATED_WORKER=true
MEMORY_WORKER_CONCURRENCY=1
MEMORY_ALLOWED_PLUGINS=windows.info,windows.pslist,windows.pstree,windows.psscan,windows.cmdline,windows.consoles,windows.filescan,memprocfs.findevil,linux.pslist,linux.pstree,linux.sockstat,linux.bash
MEMORY_ALLOWED_PROFILES=metadata_only,processes_basic,processes_extended,shell_history_basic,files_basic,find_evil
MEMORY_DEFAULT_PROFILE=metadata_only
MEMORY_PROCESS_PROFILE_ENABLED=false
MEMORY_MAX_PROCESS_ROWS=100000
MEMORY_MAX_COMMAND_LINE_LENGTH=16384
MEMORY_MAX_RAW_FIELD_LENGTH=65536
MEMORY_RAW_OUTPUT_RETENTION_ENABLED=true
MEMORY_SYMBOL_NETWORK_ACCESS_ENABLED=false
MEMORY_SYMBOL_MODE=offline_only
MEMORY_SYMBOL_MANAGED_DOWNLOAD_ENABLED=false
# true: the memory worker downloads a missing Windows kernel PDB from msdl.microsoft.com (only the PDB
# name, GUID and age leave the server) and converts it to the ISF Volatility needs.
MEMORY_SYMBOL_DIRECT_DOWNLOAD_ENABLED=false
# A raw capture whose page tables Volatility cannot find is read through MemProcFS's crash-dump view,
# written once per evidence (about the size of the image) when the disk has room for it.
MEMORY_VOLATILITY_CRASHDUMP_VIEW_ENABLED=true
MEMORY_VOLATILITY_CRASHDUMP_TIMEOUT_SECONDS=7200
MEMORY_SYMBOL_ALLOWED_HOSTS=
MEMORY_SYMBOL_DOWNLOAD_TIMEOUT_SECONDS=180
MEMORY_SYMBOL_CONNECT_TIMEOUT_SECONDS=15
MEMORY_SYMBOL_MAX_REDIRECTS=5
MEMORY_SYMBOL_DOWNLOAD_MAX_BYTES=1073741824
MEMORY_SYMBOL_ISF_MAX_BYTES=268435456
MEMORY_SYMBOL_CACHE_MAX_BYTES=5368709120
MEMORY_SYMBOL_CACHE_ROOT=/volatility-cache
MEMORY_SYMBOL_DOWNLOAD_CONCURRENCY=1
MEMORY_SYMBOL_TASK_QUEUE=memory-symbols
MEMORY_SYMBOL_PARTIAL_TTL_SECONDS=86400
MEMORY_SYMBOL_REQUEST_STALE_SECONDS=900
MEMORY_SYMBOL_INITIAL_HOST=msdl.microsoft.com
MEMORY_SYMBOL_REDIRECT_SUFFIXES=.blob.core.windows.net
MEMORY_SYMBOL_NETWORK_ISOLATION_READY=false
MEMORY_SYMBOL_ADMIN_AUTHORIZATION_ENFORCED=false
MEMORY_SYMBOL_ADMIN_AUTHORIZATION_REQUIRED=true

# ---- Symbol Egress Gateway ----
MEMORY_SYMBOL_EGRESS_GATEWAY_URL=http://symbol-egress-gateway:8443
MEMORY_SYMBOL_EGRESS_GATEWAY_PORT=8443
MEMORY_SYMBOL_EGRESS_REPLAY_WINDOW_SECONDS=60
MEMORY_SYMBOL_EGRESS_MAX_RESPONSE_BYTES=1073741824

# ---- Symbol local approval ----
MEMORY_SYMBOL_LOCAL_APPROVAL_ENABLED=false
MEMORY_SYMBOL_APPROVAL_TTL_SECONDS=600
MEMORY_SYMBOL_APPROVAL_SINGLE_USE=true

# ---- Build metadata ----
APP_VERSION=1.2.0
VOLATILITY3_VERSION=2.28.0
KAIRON_COMMIT=unknown
BUILD_DATE=unknown

# ---- Frontend ----
FRONTEND_API_BASE_URL=http://localhost:8000/api

# ---- Helper script URLs ----
DFIR_BACKEND_URL=http://127.0.0.1:8000
DFIR_FRONTEND_URL=http://127.0.0.1:5173
DFIR_BACKUP_ROOT=./backups

# =====================================================================
# Further settings (all optional; values are the built-in defaults).
# =====================================================================

# ---- Reports: branding of exported reports ----
REPORT_BRAND_NAME="Kairon DFIR"
REPORT_BRAND_SUBTITLE="Digital Forensics & Incident Response"
REPORT_BRAND_PRIMARY_COLOR="#0f172a"
REPORT_INCLUDE_LOGO=false
REPORT_LOGO_PATH=

# ---- Archives and ingest limits ----
# MAX_ARCHIVE_DEPTH: archives inside archives followed; the timeouts bound one extraction / one ingest job.
MAX_ARCHIVE_DEPTH=5
ARCHIVE_EXTRACTION_TIMEOUT_SECONDS=1800
INGEST_JOB_TIMEOUT_SECONDS=10800
ARTIFACT_RETRY_JOB_TIMEOUT_SECONDS=10800

# ---- Uploads: multipart and browser folder uploads ----
# Folder upload from the browser is experimental and off; prefer a ZIP/7z or a server-mounted path.
BACKEND_MULTIPART_MAX_FILES=10000
BACKEND_MULTIPART_MAX_FIELDS=20000
BACKEND_MULTIPART_MAX_PART_SIZE=1048576
BACKEND_ENABLE_EXPERIMENTAL_FOLDER_UPLOAD=false
BACKEND_EXPERIMENTAL_FOLDER_UPLOAD_MAX_FILES=2000
BACKEND_EXPERIMENTAL_FOLDER_UPLOAD_MAX_TOTAL_BYTES=2147483648

# ---- Disk images: file browser and export ----
DISK_FILE_BROWSER_MAX_ENTRIES=10000
DISK_FILE_EXPORT_MAX_FILES=5000
DISK_FILE_EXPORT_MAX_BYTES=2147483648

# ---- Event logs (EVTX) ----
# EVTX_PARSER_BACKEND: auto, evtx_raw_python, evtxecmd_csv or evtxecmd_json. The fast profile bounds records/time per file and in total;
# the other values detect a stalled or endless parse.
EVTX_PARSER_BACKEND=auto
EVTX_FAST_MAX_RECORDS_PER_FILE=5000
EVTX_FAST_MAX_SECONDS_PER_FILE=120
EVTX_FAST_MAX_TOTAL_RECORDS=25000
EVTX_FAST_MAX_TOTAL_SECONDS=600
EVTX_ARTIFACT_MAX_SECONDS=180
EVTX_ARTIFACT_STALL_SECONDS=45
EVTX_LONG_TAIL_WARNING_SECONDS=900
EVTX_NO_PROGRESS_STALL_SECONDS=600
EVTX_MAX_ACTIVE_RUNTIME_SECONDS=3600
EVTX_DEFER_AFTER_SECONDS=3600
EVTX_MIN_PROGRESS_DELTA_RECORDS=100

# ---- Eric Zimmerman tools and the MFT ----
# Timeouts in seconds, 0 = no limit of their own (the job's applies).
EVTXECMD_TIMEOUT_SECONDS=0
MFTECMD_TIMEOUT_SECONDS=0
SRUMECMD_TIMEOUT_SECONDS=0
SBECMD_TIMEOUT_SECONDS=0
MFT_FAST_PATH=true
MFT_SUMMARY_MAX_RECORDS=10000
MFT_SUMMARY_MAX_SECONDS=1800

# ---- Detections and hunting ----
SIGMA_MAX_MATCHES_PER_RULE=5000
SIGMA_MAX_DETECTIONS_PER_RULE=1000
SIGMA_NOISY_RULE_THRESHOLD=10000
RULE_RUN_STALE_AFTER_MINUTES=10
HUNTING_EVALUATION_TIMEOUT_SECONDS=7200

# ---- Memory: uploads ----
# Chunked memory upload: chunk sizes, parallel chunks, how long an unfinished upload is kept, the free space
# it must leave, and the total memory evidence per case.
MEMORY_UPLOAD_CHUNK_SIZE_MIN_BYTES=1048576
MEMORY_UPLOAD_CHUNK_SIZE_MAX_BYTES=268435456
MEMORY_UPLOAD_MAX_PARALLEL_CHUNKS=2
MEMORY_UPLOAD_SESSION_TTL_SECONDS=86400
MEMORY_UPLOAD_MIN_FREE_SPACE_BYTES=53687091200
MEMORY_UPLOAD_CASE_QUOTA_BYTES=107374182400

# ---- Memory: automation and run limits ----
# Preparation (probe + symbol requirement) runs on its own after a memory upload; Run all runs every profile.
MEMORY_AUTO_PREPARATION=true
MEMORY_AUTO_SYMBOL_PROBE=true
MEMORY_AUTO_SYMBOL_ACQUIRE=false
MEMORY_RUN_ALL_ENABLED=true
MEMORY_PREPARATION_STALE_SECONDS=600
MEMORY_PROFILE_TIMEOUT_OVERHEAD_SECONDS=300
MEMORY_JOB_TIMEOUT_CLEANUP_MARGIN_SECONDS=300
MEMORY_PLUGIN_TERMINATION_GRACE_SECONDS=15
MEMPROCFS_CRASH_RETRY_ENABLED=true

# ---- Memory: Windows symbols, import and recovery ----
# Administrator import of a PDB/ISF or an offline symbol package, and the limits applied to what is imported.
# See docs/memory/memory_symbols.md.
MEMORY_SYMBOL_MANUAL_IMPORT_ENABLED=false
MEMORY_SYMBOL_ADMIN_RECOVERY_ENABLED=false
MEMORY_SYMBOL_CORPORATE_SOURCE_ENABLED=false
MEMORY_SYMBOL_AUTOMATIC_FALLBACK_ENABLED=false
MEMORY_SYMBOL_CORPORATE_CONNECT_TIMEOUT_SECONDS=15
MEMORY_SYMBOL_CORPORATE_READ_TIMEOUT_SECONDS=120
MEMORY_SYMBOL_MAX_CONCURRENT_ACQUISITIONS=1
MEMORY_SYMBOL_ACQUISITION_RETRY_LIMIT=2
MEMORY_SYMBOL_NEGATIVE_CACHE_TTL_SECONDS=86400
MEMORY_SYMBOL_RECONCILE_INTERVAL_SECONDS=300
MEMORY_SYMBOL_EGRESS_GATEWAY_TIMEOUT_SECONDS=60
MEMORY_SYMBOL_PDB_UPLOAD_MAX_BYTES=536870912
MEMORY_SYMBOL_ISF_UPLOAD_MAX_BYTES=268435456
MEMORY_SYMBOL_PACKAGE_MAX_BYTES=1073741824
MEMORY_SYMBOL_PACKAGE_EXTRACT_MAX_BYTES=5368709120
MEMORY_SYMBOL_PACKAGE_MAX_FILES=100
MEMORY_SYMBOL_PACKAGE_ALLOWED_EXTENSIONS=.pdb,.isf,.json,.xz
MEMORY_SYMBOL_ISF_MAX_OBJECTS=200000
MEMORY_SYMBOL_ISF_MAX_DEPTH=32
MEMORY_SYMBOL_ISF_MAX_STRING_BYTES=1048576
MEMORY_SYMBOL_ISF_MAX_OBJECT_KEYS=10000
MEMORY_SYMBOL_ISF_MAX_ARRAY_LENGTH=100000

# ---- Memory: Linux symbols ----
# Upload of a Linux ISF / Volatility 2 profile for an image's kernel (off by default). See docs/memory/linux_symbols.md.
MEMORY_LINUX_SYMBOL_MANUAL_IMPORT_ENABLED=false
MEMORY_LINUX_SYMBOL_EXTERNAL_DOWNLOAD_ENABLED=false
MEMORY_LINUX_SYMBOL_ISF_UPLOAD_MAX_BYTES=268435456
MEMORY_LINUX_SYMBOL_ISF_DECOMPRESSED_MAX_BYTES=536870912
MEMORY_LINUX_SYMBOL_VALIDATION_TIMEOUT_SECONDS=30
MEMORY_LINUX_SYMBOL_VALIDATION_TERMINATION_GRACE_SECONDS=5

# ---- Memory: native Volatility probe ----
MEMORY_NATIVE_PROBE_ENABLED=false
MEMORY_NATIVE_PROBE_TIMEOUT_SECONDS=600
MEMORY_NATIVE_PROBE_MAX_OUTPUT_BYTES=10485760
MEMORY_NATIVE_PROBE_MIN_PROCESS_ROWS=3
MEMORY_NATIVE_PROBE_MALFORMED_ROW_RATIO=0.5
MEMORY_NATIVE_PROBE_STALE_SECONDS=900
MEMORY_NATIVE_PROBE_WORKER_CONCURRENCY=1

# ---- Evidence wizard ----
# Upload paths and options of the evidence ingestion wizard.
UNIFIED_UPLOAD_EVIDENCE_MEMORY_DUMP=false
UNIFIED_UPLOAD_EVIDENCE_DISK_IMAGE=false
UNIFIED_UPLOAD_EVIDENCE_ARCHIVE=false
WIZARD_ADVANCED_OPTIONS_ENABLED=false

# ---- Optional integrations ----
# Import evidence from S3 / Azure Blob Storage (the server downloads from outside the lab, so off by
# default); credentials are set by an administrator in the UI. See docs/evidence/s3-import.md and
# docs/evidence/azure-blob-import.md.
S3_SOURCE_ENABLED=false
AZURE_BLOB_SOURCE_ENABLED=false
# MCP server (docker compose --profile mcp up -d), read from .env by docker compose: a read-only
# service token (Service Tokens page), the token MCP clients send (32+ characters), the address it
# listens on and the host names clients use. See docs/operations/mcp-server.md.
KAIRON_MCP_SERVICE_TOKEN=
KAIRON_MCP_HTTP_TOKEN=
KAIRON_MCP_BIND=127.0.0.1
KAIRON_MCP_ALLOWED_HOSTS=
