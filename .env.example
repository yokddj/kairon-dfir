# Kairon DFIR deployment configuration
# Generated by scripts/setup.sh — run that instead of editing manually.
#
# Documentation status: technical draft pending maintainer review.

KAIRON_DEPLOYMENT_MODE=localhost
KAIRON_PUBLIC_URL=http://localhost:5173
KAIRON_AUTH_ENABLED=true
APP_VERSION=1.2.0

# Host-side port for the API container (not the browser-facing URL above --
# the browser and all internal traffic go through the frontend's /api proxy
# on port 5173; this only matters if something else on this machine already
# listens on 8000, e.g. Splunk Web). Change and re-run setup.sh if needed:
#   KAIRON_API_PORT=8001 bash scripts/setup.sh
KAIRON_API_PORT=8000

# ---- Secrets (auto-generated by setup.sh) ----
KAIRON_SESSION_SECRET=
# Encrypts AI provider API keys at rest. Falls back to KAIRON_SESSION_SECRET
# when unset; rotating either invalidates the stored provider keys.
KAIRON_AI_SECRET_KEY=
POSTGRES_PASSWORD=
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# ---- Optional bootstrap admin (prefer CLI: python -m app.cli create-admin) ----
KAIRON_BOOTSTRAP_ADMIN_USERNAME=
KAIRON_BOOTSTRAP_ADMIN_EMAIL=
KAIRON_BOOTSTRAP_ADMIN_PASSWORD=

# ---- Optional features ----
KAIRON_ENABLE_MEMORY=false

# ---- Optional MCP server (docker compose --profile mcp up -d) ----
# A read-only service token for it to use: create one as an administrator,
# POST /api/admin/service-tokens, then paste the token value here. See
# docs/operations/mcp-server.md.
KAIRON_MCP_SERVICE_TOKEN=

# ---- Advanced overrides (see config/defaults.env for all defaults) ----
# POSTGRES_HOST=postgres
# REDIS_URL=redis://redis:6379/0
# BACKEND_LOG_LEVEL=INFO

# ---- Evidence from S3 (off by default: the server downloads from outside the lab) ----
# Credentials are set by an administrator in the UI (S3 Source). See docs/evidence/s3-import.md.
S3_SOURCE_ENABLED=false

# ---- Evidence from Azure Blob Storage (off by default, same reason) ----
# Credentials are set by an administrator in the UI (Azure Blob Source). See docs/evidence/azure-blob-import.md.
AZURE_BLOB_SOURCE_ENABLED=false
