# Kairon DFIR deployment configuration
# Generated by scripts/setup.sh — run that instead of editing manually.
#
# Documentation status: technical draft pending maintainer review.

KAIRON_DEPLOYMENT_MODE=localhost
KAIRON_PUBLIC_URL=http://localhost:5173
KAIRON_AUTH_ENABLED=true
APP_VERSION=0.9.0-beta

# ---- Secrets (auto-generated by setup.sh) ----
KAIRON_SESSION_SECRET=
KAIRON_CSRF_SECRET=
POSTGRES_PASSWORD=
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# ---- Optional bootstrap admin (prefer CLI: python -m app.cli create-admin) ----
KAIRON_BOOTSTRAP_ADMIN_USERNAME=
KAIRON_BOOTSTRAP_ADMIN_EMAIL=
KAIRON_BOOTSTRAP_ADMIN_PASSWORD=

# ---- Optional features ----
KAIRON_ENABLE_MEMORY=false

# ---- Advanced overrides (see config/defaults.env for all defaults) ----
# POSTGRES_HOST=postgres
# REDIS_URL=redis://redis:6379/0
# BACKEND_LOG_LEVEL=INFO
